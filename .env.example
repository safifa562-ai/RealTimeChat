# Copy these variable names to Render Environment settings.
# Do not commit real secrets into GitHub.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Render automatically provides PORT; locally the server defaults to 10000.

# Optional website checkout. Use keys from an adult-owned/approved merchant account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
